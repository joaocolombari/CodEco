# Source repositories can be recreated from data/manifest-lock-v1.json.
external/

# Audio and generated codec outputs must never enter Git.
data/audio/
data/derived/
data/downloads/
data/music/

# Resumable pipeline state and regenerated reports. Published result snapshots
# must be promoted deliberately to a versioned release, never committed by a run.
data/cache/
data/checkpoints/
data/prepared/
data/samples/
data/tests/
results/

# Local caches and environments.
.venv/
.tools/
__pycache__/
*.pyc
*.inspect.ndjson
.DS_Store

# Generated seminar demonstrations.
notebooks/outputs/
.ipynb_checkpoints/

# Local experiment reports are reproducible from frozen manifests and results.
reports/*.csv
reports/*.json
reports/*.png
